FROM ubuntu:26.04@sha256:3131b4cc82a783df6c9df078f86e01819a13594b865c2cad47bd1bca2b7063bb

ARG DAPPER_HOST_ARCH=amd64
ARG GO_VERSION=1.26.5
ARG GO_SHA256_amd64=5c2c3b16caefa1d968a94c1daca04a7ca301a496d9b086e17ad77bb81393f053
ARG GO_SHA256_arm64=fe4789e92b1f33358680864bbe8704289e7bb5fc207d80623c308935bd696d49
ARG DOCKER_VERSION=29.4.2
ARG UBUNTU_MIRROR=http://archive.ubuntu.com/ubuntu

ENV DEBIAN_FRONTEND=noninteractive
ENV HOST_ARCH=${DAPPER_HOST_ARCH} \
    ARCH=${DAPPER_HOST_ARCH} \
    GOPATH=/go \
    PATH=/go/bin:/usr/local/go/bin:${PATH} \
    SHELL=/bin/bash \
    GOCACHE=/tmp/go-build-cache \
    GOFLAGS=-mod=mod \
    GOTELEMETRY=off \
    XDG_CONFIG_HOME=/tmp/go-config \
    GIT_CONFIG_GLOBAL=/tmp/gitconfig

RUN set -eux; \
    find /etc/apt -type f \( -name '*.list' -o -name '*.sources' \) -exec sed -i \
        -e "s|http://security.ubuntu.com/ubuntu|${UBUNTU_MIRROR}|g" \
        -e "s|http://archive.ubuntu.com/ubuntu|${UBUNTU_MIRROR}|g" {} +; \
    printf 'Acquire::Retries "5";\nAcquire::http::Timeout "30";\nAcquire::https::Timeout "30";\nAcquire::http::Pipeline-Depth "0";\n' > /etc/apt/apt.conf.d/80pasturestack-retries; \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        file \
        gcc \
        git \
        libc6-dev \
        make \
        tar \
        xz-utils && \
    rm -rf /var/lib/apt/lists/* && \
    rm -f /usr/bin/pebble && \
    rm -f /bin/sh && ln -s /bin/bash /bin/sh

RUN git config --system --add safe.directory '*'

RUN case "${DAPPER_HOST_ARCH}" in \
        amd64) go_arch=amd64; docker_arch=x86_64; go_sha="${GO_SHA256_amd64}" ;; \
        arm64) go_arch=arm64; docker_arch=aarch64; go_sha="${GO_SHA256_arm64}" ;; \
        *) echo "unsupported DAPPER_HOST_ARCH=${DAPPER_HOST_ARCH}" >&2; exit 1 ;; \
    esac && \
    curl -fsSL -o /tmp/go.tgz "https://go.dev/dl/go${GO_VERSION}.linux-${go_arch}.tar.gz" && \
    echo "${go_sha}  /tmp/go.tgz" | sha256sum -c - && \
    tar -C /usr/local -xzf /tmp/go.tgz && \
    rm -f /tmp/go.tgz && \
    curl -sfL "https://download.docker.com/linux/static/stable/${docker_arch}/docker-${DOCKER_VERSION}.tgz" | \
        tar xzf - -C /usr/bin --strip-components=1 docker/docker && \
    chmod +x /usr/bin/docker && \
    mkdir -p /go/bin /go/src && \
    go version && \
    docker --version

ENV DAPPER_SOURCE=/go/src/github.com/PastureStack/container-cron/ \
    DAPPER_OUTPUT="./bin ./dist" \
    DAPPER_DOCKER_SOCKET=true \
    DAPPER_ENV="REPO IMAGE_NAME TAG VERSION_OVERRIDE REVISION DOCKER_BUILD_NETWORK UBUNTU_MIRROR" \
    HOME=/go/src/github.com/PastureStack/container-cron/
WORKDIR ${DAPPER_SOURCE}

ENTRYPOINT ["./scripts/entry"]
CMD ["ci"]
